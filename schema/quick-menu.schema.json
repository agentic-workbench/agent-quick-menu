{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agentic-workbench/agent-quick-menu/main/schema/quick-menu.schema.json",
  "title": "agent-quick-menu plugin menu file",
  "description": "A plugin's .claude-plugin/quick-menu.json: quick-launch commands and settings shown in the quick menu. The limits are enforced when the menu reads the file; unknown keys stay allowed.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "description": "Schema version. An unknown version is skipped with a notice." },
    "title": { "type": "string", "maxLength": 60, "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Co}\\u{FE00}-\\u{FE0F}\\u{E0100}-\\u{E01EF}]*$", "description": "Section heading; default the plugin name. Not Claude Code, Favourites, built-in or another plugin's name." },
    "commands": {
      "type": "array",
      "maxItems": 50,
      "description": "Quick-launch commands, shown as buttons.",
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Co}\\u{FE00}-\\u{FE0F}\\u{E0100}-\\u{E01EF}]*$", "description": "Command name as / takes it, without the slash." },
          "label": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^(?=.*\\S)[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Co}\\u{FE00}-\\u{FE0F}\\u{E0100}-\\u{E01EF}]*$", "description": "Button text; default the command." },
          "args": { "type": "string", "maxLength": 500, "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Co}\\u{FE00}-\\u{FE0F}\\u{E0100}-\\u{E01EF}]*$", "description": "Arguments passed as typed; one line." },
          "description": { "type": "string", "maxLength": 200, "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Co}\\u{FE00}-\\u{FE0F}\\u{E0100}-\\u{E01EF}]*$", "description": "Dimmed help text." }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 50,
      "description": "userConfig field names of this plugin, in display order. Omitted: all rows. []: none.",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
